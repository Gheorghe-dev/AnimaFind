# ==============================================================================
# AnimaFind — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local or .env for development.
# Never commit real credentials or private keys to version control.

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="https://animafind.app"

# Optional Cloud Database Connection (PostgreSQL with Drizzle ORM)
# Default standalone mobile build operates 100% offline via local IndexedDB engine.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Mobile Static Export Control
# Set to "true" during `npm run build:mobile` to produce the static output directory
OUTPUT_EXPORT="false"

# Android Release Signing (Optional for local debug, required for signed release APK/AAB)
# ANDROID_KEYSTORE_PATH="/path/to/release.keystore"
# ANDROID_KEYSTORE_PASSWORD="your-keystore-password"
# ANDROID_KEY_ALIAS="animafind-release-key"
# ANDROID_KEY_PASSWORD="your-key-password"

# Apple / iOS Code Signing (Used in CI/CD via Fastlane or Xcode)
# APPLE_CERTIFICATE_BASE64=""
# APPLE_CERTIFICATE_PASSWORD=""
# APPLE_PROVISIONING_PROFILE_BASE64=""
# APP_STORE_CONNECT_API_KEY=""
